# Comece com demo. Depois altere para postgres, após validar as credenciais.
MODE=demo
A7_HOST=IP_DO_SERVIDOR_ALPHA7
A7_PORT=5432
A7_DATABASE=NOME_BANCO
A7_USER=USUARIO_SOMENTE_LEITURA
A7_PASSWORD=SENHA
A7_UNIT=1

# Ultima entrada: deixar desabilitado ate confirmar a fonte no Alpha7.
# Veja docs/CONSULTA_PRODUTOS.md. Nao usar historico de custo como recebimento.
A7_ENTRY_CONFIRMED=0
A7_ENTRY_SCHEMA=
A7_ENTRY_TABLE=
A7_ENTRY_ID_KIND=
A7_ENTRY_ID_COLUMN=
A7_ENTRY_UNIT_COLUMN=
A7_ENTRY_DATE_COLUMN=
A7_ENTRY_STATUS_COLUMN=
A7_ENTRY_STATUS_VALUE=
