# Comece com demo. Depois altere para postgres, após validar as credenciais.
MODE=demo
A7_HOST=IP_DO_SERVIDOR_ALPHA7
A7_PORT=5432
A7_DATABASE=NOME_BANCO
A7_USER=USUARIO_SOMENTE_LEITURA
A7_PASSWORD=SENHA
A7_UNIT=1

# Ultima entrada: deixar desabilitado ate confirmar a fonte no Alpha7.
# Veja docs/CONSULTA_PRODUTOS.md. Nao usar historico de custo como recebimento.
A7_ENTRY_CONFIRMED=0
A7_ENTRY_SCHEMA=
A7_ENTRY_TABLE=
A7_ENTRY_ID_KIND=
A7_ENTRY_ID_COLUMN=
A7_ENTRY_UNIT_COLUMN=
A7_ENTRY_DATE_COLUMN=
A7_ENTRY_STATUS_COLUMN=
A7_ENTRY_STATUS_VALUE=

# Ultima compra: nota concluida C e entrada de estoque A, confirmados pelo usuario.
# Nao reutilizar data de custo ou entrada nao confirmada como compra.
A7_PURCHASE_CONFIRMED=1
A7_PURCHASE_SCHEMA=
A7_PURCHASE_TABLE=
A7_PURCHASE_ID_KIND=
A7_PURCHASE_ID_COLUMN=
A7_PURCHASE_UNIT_COLUMN=
A7_PURCHASE_DATE_COLUMN=
A7_PURCHASE_STATUS_COLUMN=
A7_PURCHASE_STATUS_VALUE=

# Fonte fiscal padrao identificada nos CSVs; C/A confirmados.
# SOURCE=notafiscal usa nota + item + embalagem; TABLE/ID_COLUMN etc. ficam dispensados.
A7_PURCHASE_SOURCE=notafiscal
A7_PURCHASE_MOVEMENT_VALUE=
A7_PURCHASE_CFOPS=

# Raia: auto abre janela no Windows e usa modo sem interface no Linux.
# Sempre com JavaScript e recursos da pagina ativos; nao usa perfil pessoal.
PRICE_RAIA_BROWSER_MODE=auto
# Opcional: caminho de Chrome/Edge/Chromium ja instalado.
# PRICE_BROWSER_EXECUTABLE=
